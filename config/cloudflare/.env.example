# Local-only secret for `wrangler dev`. Loaded by Wrangler because this file
# sits next to wrangler.toml. Never deployed — production uses
# `npx wrangler secret put EMAIL_WEBHOOK_SECRET`.
# This file is gitignored (via the `.env` rule in the repo .gitignore).
EMAIL_WEBHOOK_SECRET=TESTING_SECRET

EMAIL_WEBHOOK_URL=https://DEV/channels/email