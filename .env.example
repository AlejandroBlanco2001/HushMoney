# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.

# Telegram — create your bot via @BotFather, then paste the token here.
# TELEGRAM_CHAT_ID is your personal Telegram user ID (not the bot's).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-personal-chat-id-here

# Nebius / NVIDIA inference
NEBIUS_API_KEY=your-nebius-api-key-here

# Cloudflare Email Worker — shared secret to authenticate inbound email POSTs.
# Set the same value in your Cloudflare Worker environment variables.
EMAIL_WEBHOOK_SECRET=generate-a-random-secret-here

# Forwarder → Hermes gateway
HERMES_GATEWAY_URL=http://localhost:8080/gateway
HERMES_GATEWAY_SECRET=your-hermes-gateway-secret-here
