# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.

# Telegram — create your bot via @BotFather, then paste the token here.
# TELEGRAM_CHAT_ID is your personal Telegram user ID (not the bot's).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-personal-chat-id-here

# Optional Telegram intake: use docker-compose.telegram.yml and docs/telegram.md.
# Hermes requires this public URL to register its webhook with Telegram.
TELEGRAM_WEBHOOK_URL=https://your-deployment-host/telegram
TELEGRAM_WEBHOOK_SECRET=generate-a-random-secret-here

# Nebius / NVIDIA inference
NEBIUS_API_KEY=your-nebius-api-key-here

# AWS EC2 instance (t2.micro free tier) — used by setup.sh to SSH-deploy.
# EC2_HOST is the Elastic IP from the AWS console.
# EC2_KEY_FILE is the path to your .pem key pair file (chmod 400 it first).
EC2_HOST=your-ec2-elastic-ip
EC2_USER=ec2-user
EC2_KEY_FILE=~/.ssh/hushmoney.pem

# Forwarder → Hermes gateway
# Local dev: http://hermes:8080/gateway (docker compose service name)
HERMES_GATEWAY_URL=http://localhost:8080/gateway
HERMES_GATEWAY_SECRET=your-hermes-gateway-secret-here

# IMAP email polling — the forwarder polls your Gmail inbox every POLL_INTERVAL_SECONDS.
# Use a Gmail App Password (myaccount.google.com/apppasswords) — regular passwords are blocked.
# For Outlook/Hotmail users: set up a Gmail forwarding rule in your Outlook settings,
# then point this at your Gmail account.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=you@gmail.com
IMAP_PASSWORD=your-16-char-app-password
IMAP_MAILBOX=INBOX
# Comma-separated list of bank sender addresses to watch.
# If using Gmail forwarding from Outlook, use the Outlook address here.
BANK_SENDER_EMAILS=alerts@yourbank.com,notifications@anotherbank.com
POLL_INTERVAL_SECONDS=300
